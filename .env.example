# ==============================================================================
# FOLIO — VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO (FASES 06 E 07)
# Copie este arquivo para .env.production antes do deploy definitivo.
# Nenhum identificador abaixo deve conter dados fictícios.
# ==============================================================================

# 1. Domínio canônico definitivo (sem barra no final)
VITE_SITE_URL=https://folio-curriculos.com.br

# 2. E-mail institucional de contato e suporte (exibido em /contato e /privacidade)
VITE_CONTACT_EMAIL=

# 3. ID da propriedade Google Analytics 4 (opcional, ex.: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# 4. Código de verificação do Google Search Console (opcional)
VITE_GSC_VERIFICATION_TOKEN=

# ==============================================================================
# 5. GOOGLE ADSENSE & AD BLOCKING RECOVERY (FASE 07)
# ==============================================================================
# Publisher ID oficial do Google AdSense (formato: ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT_ID=

# IDs dos blocos de anúncio criados no painel do AdSense (apenas dígitos)
VITE_ADSENSE_SLOT_LANDING=
VITE_ADSENSE_SLOT_CONTENT=
VITE_ADSENSE_SLOT_FOOTER=

# Ativar tag oficial de Ad Blocking Recovery (Funding Choices / Privacy & Messaging): true ou false
VITE_ADSENSE_ADBLOCK_RECOVERY=false

# Exigir consentimento de cookies de publicidade antes de inicializar tags de anúncio: true ou false
VITE_ADSENSE_REQUIRE_CONSENT=true

# ==============================================================================
# 6. DOAÇÕES VOLUNTÁRIAS VIA PIX — PÁGINA /apoie (FASES 07 E 08)
# ==============================================================================
# Atenção: informe apenas dados públicos do recebedor Pix (nunca insira senhas ou tokens bancários).
# Caso omitidas, a aplicação utiliza a configuração centralizada oficial em src/config/siteConfig.ts.
# Preencha abaixo se desejar sobrescrever os dados diretamente no painel da Vercel:
VITE_PIX_KEY=
VITE_PIX_RECIPIENT_NAME=
VITE_PIX_RECIPIENT_INSTITUTION=
VITE_PIX_RECIPIENT_CITY=
VITE_PIX_TXID=FOLIOAPOIO
